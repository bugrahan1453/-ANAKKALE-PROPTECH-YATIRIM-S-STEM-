# ═══════════════════════════════════════════════
# ÇANAKKALE PROPTECH - ORTAM DEĞİŞKENLERİ
# Bu dosyayı .env olarak kopyalayın ve doldurun
# ═══════════════════════════════════════════════

# ─── UYGULAMA ───────────────────────────────────
APP_ENV=production
SECRET_KEY=BURAYA-COKU-UZUN-VE-RASTGELE-BIR-ANAHTAR-GIRIN
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── VERİTABANI ─────────────────────────────────
POSTGRES_DB=proptech
POSTGRES_USER=proptech
POSTGRES_PASSWORD=GUCLU-SIFRE-GIRIN
DATABASE_URL=postgresql+asyncpg://proptech:SIFRE@postgres:5432/proptech

# ─── REDIS ──────────────────────────────────────
REDIS_PASSWORD=REDIS-SIFRE-GIRIN
REDIS_URL=redis://:REDIS-SIFRE@redis:6379/0

# ─── FRONTEND ───────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.DOMAIN.com
NEXT_PUBLIC_WS_URL=wss://api.DOMAIN.com

# ─── YAPAY ZEKA (OpenAI / Anthropic) ────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ─── SMS / WHATSAPP BİLDİRİM ────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+90...
BROKER_PHONE_NUMBER=+90...

# ─── E-POSTA ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ofis@example.com
SMTP_PASSWORD=...

# ─── SCRAPER ─────────────────────────────────────
PROXY_API_KEY=...
PROXY_PROVIDER_URL=https://...
SCRAPE_INTERVAL_MINUTES=30

# ─── HARİTA / GEO ────────────────────────────────
GOOGLE_MAPS_API_KEY=...
TKGM_API_KEY=...

# ─── SOSYAL MEDYA ────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=...
WHATSAPP_BUSINESS_TOKEN=...

# ─── GÜVENLİK ────────────────────────────────────
CORS_ORIGINS=["https://DOMAIN.com","https://www.DOMAIN.com"]
ENCRYPTION_KEY=FERNET-32-BYTE-KEY-GIRIN
